<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Editor/Core is intentionally Unity-independent. Linking the production
    sources here makes this executable a direct regression test of the code
    shipped in every package, without copying it or adding a test SDK.
  -->
  <ItemGroup>
    <Compile Include="../../../Packages/*/Editor/Core/**/*.cs"
             Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
